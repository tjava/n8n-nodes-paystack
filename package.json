{
  "name": "n8n-nodes-paystack",
  "version": "0.1.3",
  "description": "n8n community node for the Paystack payment platform",
  "keywords": [
    "n8n-community-node-package",
    "paystack",
    "payments",
    "fintech",
    "africa",
    "payment-gateway"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tjava/n8n-nodes-paystack",
  "author": {
    "name": "Taiwo Hassan",
    "email": "devtaiwo@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tjava/n8n-nodes-paystack.git"
  },
  "main": "dist/nodes/Paystack/Paystack.node.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "lintfix": "npm run lint:fix",
    "release": "n8n-node release",
    "format": "prettier --write \"**/*.ts\""
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PaystackApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Paystack/Paystack.node.js",
      "dist/nodes/Paystack/PaystackTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.30.1",
    "@types/node": "^18.16.0",
    "eslint": "^9.39.1",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
